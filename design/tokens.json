{
  "version": 1,
  "description": "DevOps 工作区设计 token 的唯一来源。修改后必须同步 apps/web/src/shared/styles/index.css，并运行 pnpm ui:check。",
  "color": {
    "light": {
      "background": "#ffffff",
      "foreground": "#0f1115",
      "card": "#ffffff",
      "cardForeground": "var(--foreground)",
      "popover": "#ffffff",
      "popoverForeground": "var(--foreground)",
      "primary": "#4176e6",
      "primaryForeground": "#ffffff",
      "secondary": "#f9fafb",
      "secondaryForeground": "var(--foreground)",
      "muted": "#f5f6f7",
      "mutedForeground": "#61666b",
      "accent": "#ebeef2",
      "accentForeground": "var(--foreground)",
      "destructive": "#ce5252",
      "border": "rgba(15, 17, 21, 0.08)",
      "input": "rgba(15, 17, 21, 0.12)",
      "ring": "#4176e6",
      "sidebar": "#f9fafb",
      "sidebarForeground": "#0f1115"
    },
    "dark": {
      "background": "oklch(0.16 0.01 250)",
      "foreground": "oklch(0.97 0.003 250)",
      "card": "oklch(0.205 0.012 250)",
      "cardForeground": "var(--foreground)",
      "popover": "var(--card)",
      "popoverForeground": "var(--foreground)",
      "primary": "#7aa0f0",
      "primaryForeground": "#0b1220",
      "secondary": "oklch(0.26 0.012 250)",
      "secondaryForeground": "var(--foreground)",
      "muted": "var(--secondary)",
      "mutedForeground": "oklch(0.72 0.01 250)",
      "accent": "var(--secondary)",
      "accentForeground": "var(--foreground)",
      "destructive": "oklch(0.704 0.191 22.216)",
      "border": "oklch(1 0 0 / 12%)",
      "input": "oklch(1 0 0 / 15%)",
      "ring": "var(--primary)"
    }
  },
  "status": {
    "success": "#269650",
    "warning": "#c98719",
    "danger": "#ce5252",
    "info": "#4176e6"
  },
  "prototype": {
    "blue": "#4176e6",
    "blueSoft": "#edf3fe",
    "side": "#f9fafb",
    "soft": "#f5f6f7",
    "selected": "#ebeef2",
    "ink": "#0f1115",
    "muted": "#61666b",
    "quiet": "#81858c",
    "line": "rgba(0, 0, 0, 0.08)",
    "green": "#269650",
    "amber": "#c98719",
    "red": "#ce5252"
  },
  "radius": {
    "base": "0.625rem",
    "sm": "calc(var(--radius) * 0.6)",
    "md": "calc(var(--radius) * 0.8)",
    "lg": "var(--radius)",
    "xl": "calc(var(--radius) * 1.4)",
    "2xl": "calc(var(--radius) * 1.8)",
    "full": "999px"
  },
  "typography": {
    "fontSans": "'Geist Variable', 'PingFang SC', 'Microsoft YaHei', sans-serif",
    "bodySize": 14,
    "metaSize": 12,
    "titleSize": 19,
    "displaySize": 25,
    "lineHeightBody": 1.5
  },
  "spacing": {
    "unit": 4,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "2xl": 32
  },
  "layout": {
    "sidebarWidth": 232,
    "contentMaxWidth": 1280,
    "pagePaddingDesktop": 24,
    "pagePaddingMobile": 16
  },
  "motion": {
    "fast": 150,
    "normal": 200,
    "slow": 320,
    "reducedMotion": "respect prefers-reduced-motion"
  }
}
