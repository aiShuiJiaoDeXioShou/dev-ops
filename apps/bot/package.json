{
  "name": "@dev-ops/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --import tsx --test test/*.test.ts",
    "test:db": "node --import tsx --test test/store.test.ts",
    "check:boundaries": "pnpm --dir ../.. exec depcruise --config tooling/dependency-rules.mjs apps/bot/src",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:boundaries"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.1.0",
    "typebox": "^1.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
