# 执行节点 Agent 环境变量示例；复制为 .env 后由部署系统注入，禁止提交真实令牌。
# Agent 主动外连平台，平台不反向访问节点网络。令牌只保存在进程内存，不写入磁盘。

# 平台 API 地址（含协议与端口，不含 /api/v1 前缀）；本地开发允许 HTTP，生产必须 HTTPS。
PLATFORM_URL=http://127.0.0.1:3001

# 注册令牌与长期令牌二选一：
# - 首次注册使用团队管理员创建节点时返回的一次性 AGENT_REGISTRATION_TOKEN；
#   注册成功后平台返回长期令牌，应改配 AGENT_TOKEN 再启动，避免重复使用一次性令牌。
# - 已注册节点使用 AGENT_TOKEN。
AGENT_REGISTRATION_TOKEN=
AGENT_TOKEN=

# 注册节点名，缺省为主机名；服务端以注册令牌绑定的节点为权威身份。
AGENT_NAME=

# Agent 工作根目录（宿主绝对路径）；运行工作区与临时产物都创建在其下，运行结束清理。
AGENT_WORK_DIR=./pipeline-agent-data

# 能力标签，逗号分隔；必须与团队注册节点时配置的标签一致才能被调度。
AGENT_LABELS=linux,docker,node24

# 租约短轮询等待秒数（0–30，默认 20）；平台可提前返回。
AGENT_POLL_WAIT_SECONDS=20
# 普通平台请求超时（毫秒，默认 15000）；所有请求都受超时与有限重试约束。
AGENT_HTTP_TIMEOUT_MS=15000
# 产物流式上传超时（毫秒，默认 300000）。
AGENT_ARTIFACT_UPLOAD_TIMEOUT_MS=300000

# 单个产物大小上限（字节，默认 524288000）；超过时步骤失败，不生成空产物。
AGENT_ARTIFACT_MAX_BYTES=524288000
# 单个日志分片大小上限（字节，默认 65536，不得超过协议上限 262144）。
AGENT_LOG_CHUNK_MAX_BYTES=65536

# 任务容器资源限制：CPU 核数（可小数）、内存（MB）、最大进程数。
AGENT_CONTAINER_CPUS=1
AGENT_CONTAINER_MEMORY_MB=2048
AGENT_CONTAINER_PIDS_LIMIT=512
# 容器运行用户（uid:gid）；缺省使用 Agent 进程用户，Agent 以 root 运行时回退 1000:1000。
# AGENT_CONTAINER_USER=1000:1000

# Docker Engine socket；缺省使用 dockerode 默认值（/var/run/docker.sock）。
# 任务容器不会挂载该 socket，Agent 自身持有 Docker 权限。
# AGENT_DOCKER_SOCKET=/var/run/docker.sock
