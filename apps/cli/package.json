{
  "name": "@dev-ops/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "devops": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "NODE_ENV=test node --import tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@dev-ops/api-client": "workspace:*",
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.1.0",
    "env-paths": "^4.0.0",
    "write-file-atomic": "^8.0.0",
    "zod": "^4.6.7"
  }
}
