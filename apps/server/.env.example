NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# 生产环境默认关闭接口文档，其他环境默认开启。
# DOCS_ENABLED=true

# db:setup 自动生成本地密码和实际连接地址；不要直接使用此占位密码。
DATABASE_URL=postgresql://dev_ops_app:replace_me@127.0.0.1:5433/dev_ops
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000

# ===== V0.1 新增配置（实现 T003 后由 env.ts 校验） =====
APP_ORIGIN=http://localhost:5173
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:5173
DOCS_ENABLED=false
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=noreply@example.test
GIT_CREDENTIAL_ENCRYPTION_KEY=
ROOT_EMAIL=admin@example.test
ROOT_INITIAL_PASSWORD=
GITHUB_AUTH_MODE=cli
GITHUB_ALLOWED_REPOS=aiShuiJiaoDeXioShou/dev-ops
# GitHub App 接入后填写；Setup URL 在 GitHub App 设置中配置
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_SLUG=

# ===== V0.2 =====
# 未新增环境变量：通用凭据复用 GIT_CREDENTIAL_ENCRYPTION_KEY；产物只保存引用，不配置对象存储；不建本地仓库缓存。

# ===== V0.4a 流水线执行器 =====
# 日志与产物本地存储根目录；需可写并与部署数据目录一起备份。
PIPELINE_STORAGE_DIR=./pipeline-data
# 运行级默认超时（秒）；步骤级由 workflow 声明或平台默认值覆盖。
PIPELINE_RUN_TIMEOUT_SECONDS=3600
# 节点租约有效期与心跳超时（秒）。
PIPELINE_LEASE_TTL_SECONDS=90
PIPELINE_HEARTBEAT_TIMEOUT_SECONDS=60
# 单次日志分片、单产物与单个 workflow 文件的大小上限（字节）。
PIPELINE_LOG_CHUNK_MAX_BYTES=262144
PIPELINE_ARTIFACT_MAX_BYTES=524288000
PIPELINE_WORKFLOW_MAX_BYTES=131072
