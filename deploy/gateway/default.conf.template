server {
    listen 8080;
    server_name _;

    # 在请求时解析上游，Web 容器尚未启动时也能先启动网关。
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        set $web_upstream ${GATEWAY_WEB_UPSTREAM};
        proxy_pass $web_upstream;
        proxy_connect_timeout 5s;
        proxy_read_timeout ${GATEWAY_WEB_READ_TIMEOUT};
        proxy_intercept_errors on;
        error_page 502 /__gateway-errors/502.html;
        error_page 503 /__gateway-errors/503.html;
        error_page 504 /__gateway-errors/504.html;
    }

    location /api/ {
        set $api_upstream ${GATEWAY_API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size 0;
    }

    location /__gateway-errors/ {
        internal;
        alias /usr/share/nginx/gateway-errors/;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; frame-ancestors 'none'" always;
    }
}
